{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@/*": ["./src/*"],
			"@/components/*": ["./src/components/*"],
			"@/constants/*": ["./src/constants/*"],
			"@/types/*": ["./src/types/*"],
			"@/utils/*": ["./src/utils/*"],
			"@/services/*": ["./src/services/*"],
			"@/hooks/*": ["./src/hooks/*"],
			"@/lib/*": ["./src/lib/*"],
			"@/config/*": ["./src/config/*"],
			"@/context/*": ["./src/context/*"]
		}
	}
}
